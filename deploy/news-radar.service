[Unit]
Description=News Radar real-time news verification agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/news-radar/current
EnvironmentFile=/etc/news-radar.env
Environment=DISABLE_SCHEDULER=1
ExecStart=/usr/bin/node /opt/news-radar/current/dist/server/index.mjs
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
Nice=-10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/news-radar/data
UMask=0027
LimitNOFILE=65536
CPUWeight=10000
IOSchedulingClass=best-effort
IOSchedulingPriority=0
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
