# news.11451405.xyz - News Radar
# install.sh replaces the listen and certificate placeholders for the host topology.
server {
    listen 80;
    listen [::]:80;
    __HTTPS_LISTEN_IPV4__
    __HTTPS_LISTEN_IPV6__
    server_name news.11451405.xyz;

    ssl_certificate     __CERT_FULLCHAIN__;
    ssl_certificate_key __CERT_PRIVKEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:NewsRadarTLS:10m;
    ssl_session_timeout 1d;

    set_real_ip_from 127.0.0.1;
    real_ip_header CF-Connecting-IP;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-ID $request_id;
        proxy_set_header Connection "";
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        client_max_body_size 2m;
    }
}
