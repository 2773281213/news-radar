{
  "name": "news-radar",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "新闻雷达 News Radar —— 7x24 实时新闻采集、多方核验与汇报 Agent",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.mjs",
    "check": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "check:sources": "tsx scripts/check-sources.ts",
    "release:pack": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "better-sqlite3": "^12.2.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^1.14.0",
    "@playwright/test": "^1.54.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^0.31.0",
    "drizzle-orm": "^0.44.0",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^4.5.0",
    "hono": "^4.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0",
    "wouter": "^3.7.0"
  }
}
