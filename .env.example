# ============ 基础 ============
# 监听地址与端口（生产环境仅监听本机，由 nginx 反代）
HOST=127.0.0.1
PORT=8787
# 数据目录（SQLite 数据库、备份都在这里）
DATA_DIR=./data
# 对外访问地址（用于 RSS 导出、推送链接等）
PUBLIC_BASE_URL=https://news.11451405.xyz
# 默认显示时区（用户可在前端另行设置）
DEFAULT_TZ=Asia/Shanghai
# 管理接口令牌（必填，请用随机长字符串，例如 openssl rand -hex 24 生成）
ADMIN_TOKEN=

# ============ 采集 ============
# RSSHub 实例地址（公共实例经常限流，建议自建）
RSSHUB_BASE=https://rsshub.app
# 采集并发数
FETCH_CONCURRENCY=4
# 抓取 User-Agent（保持可识别，尊重站点方）
USER_AGENT=NewsRadarBot/1.0 (+https://news.11451405.xyz/about)
# 仅当本地透明代理使用 198.18.0.0/15 fake-ip DNS 时设为 1；生产环境保持 0
ALLOW_PROXY_FAKE_IP=0

# ============ 三省六部工作流 ============
# 每次调度最多处理的事件数
WORKFLOW_BATCH_SIZE=30
# 单次运行租约秒数，防止并发调度重复执行
WORKFLOW_LEASE_SEC=300
# 技术失败最大重试次数
WORKFLOW_MAX_ATTEMPTS=5

# ============ AI（可选，不配置则使用抽取式摘要降级模式）============
# 可选值: none | anthropic | openai | ollama
AI_PROVIDER=none
# 每日 AI 调用上限（防止费用失控）
AI_DAILY_BUDGET=200

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-opus-5

# OpenAI 兼容接口（也适用于自建中转）
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# ============ 提醒通道（全部可选）============
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Web Push VAPID 密钥对（node scripts/gen-vapid.mjs 生成）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@11451405.xyz
